PORT=3001
NODE_ENV=development
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui
# Solo del lado del servidor: nunca en el frontend ni en el repo.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
# Orígenes del frontend (CORS y destino del link de confirmación de email), separados por coma.
ALLOWED_ORIGINS=http://localhost:5173

# Verificación de identidad contra ARCA (Padrón A13). Deshabilitada en el MVP: con false el
# backend no crea el cliente, no expone /api/identity y nunca contacta a ARCA. No hay modo mock.
ARCA_ENABLED=false

# Solo con ARCA_ENABLED=true (si faltan, el backend no arranca). Certificado y clave fuera del
# repo (backend/certs/ está en .gitignore) y nunca en la base de datos.
# ARCA_ENV=homologacion
# ARCA_CUIT=
# ARCA_CERT_PATH=./certs/arca.crt
# ARCA_KEY_PATH=./certs/arca.key
# ARCA_TIMEOUT_MS=10000
# Intentos de verificación permitidos por usuario en la ventana (minutos).
# IDENTITY_MAX_ATTEMPTS=5
# IDENTITY_ATTEMPT_WINDOW_MINUTES=1440

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
VITE_API_URL=http://localhost:3001

# Cloudflare Turnstile (clave pública del sitio). En desarrollo, si falta, se usa la clave de
# prueba 1x00000000000000000000AA, que va con la secreta de prueba en el dashboard de Supabase.
VITE_TURNSTILE_SITE_KEY=

# Login con Google (oculto hasta configurarlo en Supabase).
VITE_ENABLE_GOOGLE_AUTH=false

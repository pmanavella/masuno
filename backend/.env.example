PORT=3001
NODE_ENV=development
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui
# Solo del lado del servidor: nunca en el frontend ni en el repo.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
ALLOWED_ORIGINS=http://localhost:5173

# Verificación de identidad contra ARCA (Padrón A13).
# mock: fixtures locales (no arranca si NODE_ENV=production). real: WSAA + Padrón A13.
ARCA_MODE=mock
# Solo para ARCA_MODE=real:
ARCA_ENV=homologacion
ARCA_CUIT=20123456789
ARCA_CERT_PATH=./certs/arca.crt
ARCA_KEY_PATH=./certs/arca.key
ARCA_TIMEOUT_MS=10000

# Intentos de verificación permitidos por usuario en la ventana (minutos).
IDENTITY_MAX_ATTEMPTS=5
IDENTITY_ATTEMPT_WINDOW_MINUTES=1440
